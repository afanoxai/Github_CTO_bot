TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
DEEPSEEK_API_KEY=
GITHUB_PAT=
TELEGRAM_WEBHOOK_SECRET=

# --- Single-PR flow (the reliable, client-facing default) ---
# Comma-separated allow-list of repos the agent may open PRs/issues into (owner/repo,owner/repo).
# The first entry is the default when a message names no repo. Select another with a leading
# "repo: <name> ..." in the message. Never org-wide; the PAT must be scoped to exactly these repos.
GITHUB_PR_REPOS=

# --- Autonomous milestone builder (off by default; experimental) ---
# Leave unset/false for the client-facing bot. "true" enables the multi-milestone roadmap builder,
# which needs a backend that can run long builds (not the 300s serverless cap).
ENABLE_AUTONOMOUS_BUILDER=
GITHUB_PLAYGROUND_REPO=
GITHUB_TARGET_REPO=
