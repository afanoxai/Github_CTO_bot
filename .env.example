# =============================================================================
# AgentOps v3 environment (see CLAUDE_agent_v3.md Section 7)
# All of these are read and validated in ONE place: src/config/env.ts
# =============================================================================

# --- Core secrets (required) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram IDs of approved users. May be empty at first run:
# message the bot, then read your rejected ID from the logs and add it here.
ALLOWED_TELEGRAM_USER_IDS=
DEEPSEEK_API_KEY=
GITHUB_PAT=

# --- LLM (Layer A: swappable by config alone) ---
# Defaults to deepseek-v4-flash if unset. LLM_BASE_URL defaults to https://api.deepseek.com
LLM_MODEL=
LLM_BASE_URL=

# --- GitHub repos (Layer E) ---
# Free-write scratch space for the agent.
GITHUB_PLAYGROUND_REPO=
# Comma-separated allow-list of repos the agent may open PRs/issues into (owner/repo,owner/repo).
# Never org-wide; the PAT must be scoped to exactly these repos + the playground.
ALLOWED_TARGET_REPOS=

# --- Memory store: Upstash Redis (Layer D) ---
# From the Upstash console (REST section). If both are unset, the app falls back to an in-memory
# store that does NOT persist across serverless cold starts (fine for local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Vercel webhook only (not needed for local polling) ---
TELEGRAM_WEBHOOK_SECRET=

# --- Backward-compatible fallbacks (v2 names; still read if the v3 names above are unset) ---
# GITHUB_PR_REPOS is used if ALLOWED_TARGET_REPOS is empty.
GITHUB_PR_REPOS=
